# ========================================================
# LL LifeLink - Environment Configuration Example
# ========================================================

# --- BACKEND CONFIGURATION ---
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# Use "memory" to run embedded in-memory MongoDB with zero setup,
# or provide a local/Atlas connection string:
# mongodb://localhost:27017/ll-lifelink
MONGODB_URI=mongodb://localhost:27017/ll-lifelink

# Authentication Secrets
JWT_SECRET=ll-lifelink-super-secret-jwt-key-2026-phase1
JWT_REFRESH_SECRET=ll-lifelink-super-secret-refresh-key-2026-phase1
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Object Storage Configuration
STORAGE_PROVIDER=local
STORAGE_BUCKET=lifelink-storage
UPLOAD_DIR=./uploads

# Firebase Cloud Messaging (Push Notifications)
# If omitted, system seamlessly runs in local simulation logger mode
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# SMS Provider Configuration
# Set to 'twilio' to use real SMS or 'dev-logger' for development console output
SMS_PROVIDER=dev-logger
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# AI Provider Configuration (Google Gemini)
# If omitted, system runs with embedded senior-friendly clinical plain explainer
AI_PROVIDER=gemini
AI_API_KEY=

# Client CORS Origin
CLIENT_ORIGIN=http://localhost:3000

# --- WEB DASHBOARD CONFIGURATION ---
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# --- MOBILE APP CONFIGURATION ---
# Use 10.0.2.2 for Android emulator loopback or 127.0.0.1 for desktop/web
API_BASE_URL=http://10.0.2.2:5000/api
FIREBASE_CONFIGURATION=
